                  (line
                    (vertex
                      (pt -245000 -295000
                        (width 10000)
                      )
                      (pt -245000 295000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 377500 424800)
                    (pt 377500 -424800)
                    (pt -377500 -424800)
                    (pt -377500 424800)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -190500 -380000
                        (width 10000)
                      )
                      (pt -190500 -380000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -190500 -380000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt -190500 -370000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
