(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r100_75
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 75000)
            (height 100000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r456_405.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 405500)
            (height 456000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r90.5_49.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 49500)
            (height 90500)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r75_47.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 47500)
            (height 75000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r100_75
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r100_75))
          (noconnect (pad r100_75))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r100_75))
          (noconnect (pad r100_75))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r100_75))
          (noconnect (pad r100_75))
        )
      )
      (padstack r456_405.5
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r456_405.5))
          (noconnect (pad r456_405.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r456_405.5))
          (noconnect (pad r456_405.5))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r456_405.5))
          (noconnect (pad r456_405.5))
        )
      )
      (padstack r90.5_49.5
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r90.5_49.5))
          (noconnect (pad r90.5_49.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r90.5_49.5))
          (noconnect (pad r90.5_49.5))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r90.5_49.5))
          (noconnect (pad r90.5_49.5))
        )
      )
      (padstack r90.5_49.5
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r90.5_49.5))
          (noconnect (pad r90.5_49.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r90.5_49.5))
          (noconnect (pad r90.5_49.5))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r90.5_49.5))
          (noconnect (pad r90.5_49.5))
        )
