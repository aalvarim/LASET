        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r75_47.5))
          (noconnect (pad r75_47.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "NVMFS5C442NLWFAFT1G"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -245000 295000
                        (width 10000)
                      )
                      (pt 245000 295000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
