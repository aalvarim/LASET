                        (r 5000)
                        (begin
                          (pt -190500 -370000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt -190500 -380000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -190500 -274800)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -190500 -274800)
                  (angle 0)
                  (padstackGroup default (padstack r100_75))
                )
              )
            )
          )
          (pin 2
            (pt -63500 -274800)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -63500 -274800)
                  (angle 0)
                  (padstackGroup default (padstack r100_75))
                )
